{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-assistant-api.local/schemas/plugin-manifest.json",
  "title": "PluginManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "triggers",
    "required_setup",
    "setup_type",
    "arguments",
    "confirmation_required",
    "executor"
  ],
  "properties": {
    "triggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_setup": {
      "type": "boolean"
    },
    "setup_type": {
      "type": "string",
      "enum": ["none", "oauth_google", "oauth_generic", "form"]
    },
    "arguments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "required", "description", "prompt"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          }
        }
      }
    },
    "confirmation_required": {
      "type": "boolean"
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "config"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["composio", "composio_mcp", "http", "builtin"]
        },
        "config": {
          "type": "object"
        }
      }
    }
  }
}
