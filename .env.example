# Application
APP_NAME=smart_assistant_api
APP_ENV=development
LOG_LEVEL=debug

# HTTP server
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s

# Database: switch DB_DRIVER between "postgres" and "mongo".
# This single value is the only change needed to swap databases.
DB_DRIVER=postgres
# Postgres example:
DB_URI=postgres://postgres:postgres@localhost:5432/smart_assistant_api?sslmode=disable
# Mongo example (uncomment and set DB_DRIVER=mongo):
# DB_URI=mongodb://localhost:27017
MONGO_DATABASE=smart_assistant_api
DB_MAX_OPEN_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_CONN_TIMEOUT=5s

# Cache: switch CACHE_DRIVER between "memory" and "redis".
CACHE_DRIVER=memory
CACHE_TTL=5m
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Message queue: switch QUEUE_DRIVER between "memory" and "redis".
QUEUE_DRIVER=memory
QUEUE_MAX_ATTEMPTS=3
QUEUE_BACKOFF=1s

# Rate limiting (per user ID when authenticated, otherwise per IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# HTTP per-request timeout
HTTP_REQUEST_TIMEOUT=30s

# Auth
JWT_SECRET=change-me-in-production
JWT_TTL=15m
JWT_REFRESH_TTL=168h
JWT_ISSUER=smart_assistant_api

# OAuth (Google plugin setup)
# Local dev uses localhost; staging must match the Cloudflare Tunnel hostname
# registered in Google Cloud Console (authorized redirect URI must match exactly):
#   GOOGLE_OAUTH_REDIRECT_URL=https://jarvis-api.cymonevo.com/api/v1/plugins/oauth/google/callback
# QA-local smoke defaults (scripts/qa-local-up.sh also sets these on the api service)
GOOGLE_OAUTH_CLIENT_ID=qa-smoke-client-id
GOOGLE_OAUTH_CLIENT_SECRET=qa-smoke-secret
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/plugins/oauth/google/callback
GOOGLE_OAUTH_TOKEN_URL=http://localhost:18080/token
# Deep link the Flutter app receives after OAuth completes (default is correct for staging).
APP_OAUTH_SUCCESS_REDIRECT=smartassistant://plugin-setup/complete

# Credential encryption at rest (32-byte secret, base64 or hex; falls back to JWT_SECRET when unset)
CREDENTIALS_ENCRYPTION_KEY=

# Cloudflare Tunnel (staging public API at jarvis-api.cymonevo.com -> 127.0.0.1:8791)
# scripts/configure-cloudflare-tunnel.sh uses these during refresh-daemon.sh deploys.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# LLM (assistant plugin delegation / intent classification)
# mock — semantic mock delegator for local dev and CI (no API key)
# openai — AI delegation via OpenAI (requires LLM_API_KEY)
LLM_PROVIDER=mock
# LLM_API_KEY=              # required when LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini       # optional OpenAI model override

# Places (geocoding and nearby search; mock needs no API key)
PLACES_PROVIDER=mock
# PLACES_API_KEY=            # required when PLACES_PROVIDER=google
# PLACES_BASE_URL=           # optional provider base URL override
